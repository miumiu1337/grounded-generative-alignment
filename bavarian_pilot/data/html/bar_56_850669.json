  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"bar\" dir=\"ltr\"><style data-mw-deduplicate=\"TemplateStyles:r754690\">.mw-parser-output .BoxenVerschmelzen{border:1px solid #aaa;clear:both;font-size:95%;margin-top:1.5em;padding-top:2px}.mw-parser-output .BoxenVerschmelzen .NavFrame{border:none;font-size:100%;margin:0;padding-top:0}</style><div class=\"BoxenVerschmelzen\"><div id=\"Dialekt-oben\">\n<table align=\"center\" style=\"margin-top: 6px; margin-bottom: 6px; padding: 0.1em; border: 1px solid #B5B5B5; text-align: center; width: 100%;\">\n<tbody><tr>\n<td>Der Artikl is im Dialekt <b><a href=\"/wiki/S%C3%BCdmittelbairisch\" class=\"mw-redirect\" title=\"Südmittelbairisch\">Pongaurisch</a></b> gschriem worn.\n</td></tr></tbody></table></div>\n<table width=\"300\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"float:right; border: 1px solid #aaa; border-collapse: collapse; margin: .2em 0 .5em .5em; font-size: 90%;\">\n<tbody><tr>\n<td align=\"center\" colspan=\"2\" style=\"background-color:#ABCDEF;\"><span style=\"font-size:large;\"><b>Kinigreich Bejgien</b></span>\n<p><b>Königreich Belgien</b> (<a href=\"/wiki/Deitsch\" class=\"mw-redirect\" title=\"Deitsch\">deitsch</a>)<br />\n<b>Koninkrijk België</b> (<a href=\"/wiki/Niedal%C3%A4ndisch\" class=\"mw-redirect\" title=\"Niedaländisch\">niedaländisch</a>)<br />\n<b>Royaume de Belgique</b> (<a href=\"/wiki/Franzesisch\" class=\"mw-redirect\" title=\"Franzesisch\">franzesisch</a>) \n</p>\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"font-weight:bold; padding-left:8px; border-top:solid 1px #aaa;\">\n</td></tr>\n<tr class=\"hintergrundfarbe2\" style=\"text-align: center;\">\n<td align=\"center\" colspan=\"2\">\n<table border=\"0\" cellpadding=\"2\" cellspacing=\"0\" width=\"100%\">\n<tbody><tr>\n<td align=\"center\" width=\"50%\" style=\"background-color:transparent\">\n<figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/wiki/Datei:Flag_of_Belgium.svg\" class=\"mw-file-descripti